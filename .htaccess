Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(?:app|database|storage|tools|releases|output|node_modules)(?:/|$) - [F,END,NC]
<FilesMatch "^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|phpstan\.neon|eslint\.config\.cjs|compose\.qa\.ya?ml|Dockerfile\.qa)$">
    Require all denied
</FilesMatch>
RewriteRule ^api/bootstrap\.php(?:/|$) - [F,END,NC]
RewriteRule ^$ page.php [END]
RewriteRule ^(?:index|login|browse|item|report|claim|my-reports|admin|history|notifications|profile|settings)\.html$ page.php [END,NC]
# Scripts and styles revalidate on every load (cheap 304 via ETag), so an upgrade reaches browsers immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

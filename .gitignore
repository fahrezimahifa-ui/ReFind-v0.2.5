# Local runtime configuration and credentials
app/config.local.php
.refind-dev.json
.dev.env
api/config.local.php
.env

# Runtime uploads, auth-throttle records and local backups
storage/**
!storage/.htaccess
!storage/README.md

# QA runtime files; B01 documentation verification is intentionally retained
node_modules/
__pycache__/
*.pyc
*.log
test-results/
playwright-report/

# Local academic references and browser-review evidence are excluded from GitHub.
/docs/references/*.pdf
/output/playwright/

# Generated release archives stay local; source and checksum receipts are versioned.
releases/*.zip

.dev-npm-cache/

.dev-php-vendor/

.xampp-stage.local.json
